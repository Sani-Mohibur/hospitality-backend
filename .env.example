# Server Configuration
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority&appName=Cluster0

# Security & Bcrypt
BCRYPT_SALT_ROUNDS=10

# JWT & Authentication
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=30d
ACCESS_TOKEN_SECRET=your_access_token_secret
# Expiration time (e.g., 15m, 1h, 1d)
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES=90d

# Cloudinary (File Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587  
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=""
ADMIN_EMAIL=admin@example.com
EMAIL_EXPIRES=365d

# Stripe (Payments)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Webhook endpoint that listens to connected-account (tenant) events
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_web_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id

# Rate Limit (Standard Security)
# Window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_DELAY=0

# Security
# 32+ random characters; encrypts guest ID numbers and MFA secrets. Required in production.
DATA_ENCRYPTION_KEY=change_me_to_a_long_random_string
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
ID_DOCUMENT_RETENTION_DAYS=90

# Platform billing
# Application fee on card payments processed through Stripe Connect (40 = 0.40%)
PLATFORM_FEE_BPS=40
TRIAL_DAYS=14
DUNNING_GRACE_DAYS=14

# Background jobs (night audit scheduler, alerts, dunning, webhooks). Set false on extra API replicas.
JOBS_ENABLED=true

# SMS / WhatsApp (log = print to server log only)
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# AI ops assistant (optional)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
